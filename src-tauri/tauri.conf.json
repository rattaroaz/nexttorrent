{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexttorrent",
  "version": "0.2.0",
  "identifier": "com.nexttorrent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexttorrent",
        "width": 1100,
        "height": 720,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/rattaroaz/nexttorrent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNjI4NzQxOTFBMzM5MDUKUldRRk9hT1JRWWRpR3l4NVZkVEROT3h2enNVR1pnZ2NxTERkNXRPT0I5RU5WTnh0R0EvOUNJVHIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "CN=Nexttorrent",
    "shortDescription": "Desktop BitTorrent client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
