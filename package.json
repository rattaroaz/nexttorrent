{
  "name": "nexttorrent",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "cross-env VITE_E2E_MOCK=1 vite --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:msi": "node scripts/tauri-build.mjs",
    "build:win": "node scripts/tauri-build.mjs",
    "build:win:signed": "node scripts/tauri-build.mjs --signed",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:ipc": "node scripts/check-ipc-contracts.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "tauri:windows:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/msix-build.ps1",
    "build:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/msix-build.ps1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.18",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.3"
  }
}
